{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist/web/browser",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "supportsCancellation": true
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
