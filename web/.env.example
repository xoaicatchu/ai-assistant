# Vercel serverless proxy -> public URL of the separately deployed .NET API.
# Keep this server-side variable out of the Angular bundle.
PROXY_AGENT_BACKEND_URL=https://your-proxy-agent-api.example.com

# Optional for non-Vercel/direct deployments: call the backend directly.
# Leave this unset for Vercel; Vercel always uses same-origin /api.
NG_APP_API_BASE_URL=
